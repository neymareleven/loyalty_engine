# Database
DATABASE_URL=postgresql://user:password@localhost:5432/loyalty_engine

# --- Segmentation Apache Unomi (optional) ---
# Mode is evaluated per request from X-Brand (current user brand), not a single global brand.
#
# Shared CDP (same URL for every Unomi-enabled brand):
UNOMI_BASE_URL=https://cdp.example.com:9443
UNOMI_USERNAME=karaf
UNOMI_PASSWORD=change-me
# Default: all brands use Unomi (scope = X-Brand). No UNOMI_BRANDS list needed.
#
# Rare brands without CDP (opt-out, short list):
# UNOMI_INTERNAL_BRANDS=demo,legacy_test
#
# Or restrict to a few brands only (opt-in):
# UNOMI_BRANDS=batira,qilinsa
#
# Per-brand scope override: UNOMI_SCOPE_BATIRA=batira
# Per-brand CDP URL: UNOMI_BASE_URL_BATIRA=https://cdp-a.example.com:9443

# Storefront validate/reserve: per-process cap per API key (default 60).
# WooCommerce cart recalculation can need more; raise this if carts 429.
# STOREFRONT_RATE_LIMIT_PER_MINUTE=180
